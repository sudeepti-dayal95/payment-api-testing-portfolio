    {
      "name": "POST - Create Test Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response contains an ID\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.id).to.exist;\r\n});\r\n\r\npm.test(\"Title matches the request\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.title).to.eql(\"Payment QA Test\");\r\n});\r\n\r\npm.test(\"User ID matches the request\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.userId).to.eql(1);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"Payment QA Test\",\r\n  \"body\": \"Testing payment API response\",\r\n  \"userId\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
