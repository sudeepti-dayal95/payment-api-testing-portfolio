      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"User ID is 1\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.id).to.eql(1);\r\n});"
            ]
          }
        }
      ],
